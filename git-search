#!/usr/bin/env bash

filename=$2

if [[ -z "$filename" ]]; then
  git log -S"$1" --oneline | \
    fzf --preview 'git show --color=always {1}' --preview-window=right:70% \
        --bind 'enter:execute(git show {1} | v - +"set filetype=diff")'
else
  git log -S"$1" --oneline -- "$filename" | \
    fzf --preview 'git show --color=always {1}' --preview-window=right:70% \
        --bind "enter:execute(git show {1}:\"$filename\" | v - +'set filetype=markdown')" \
        --bind 'ctrl-d:execute(git show {1} | v - +"set filetype=diff")'
fi
